<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-faq-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest("[data-faq-item]")!;
        const content = item.querySelector("[data-faq-content]")!;
        const plus = item.querySelector("[data-faq-icon-plus]")!;
        const minus = item.querySelector("[data-faq-icon-minus]")!;
        const isOpen = !content.classList.contains("hidden");

        document.querySelectorAll("[data-faq-item]").forEach((el) => {
          el.querySelector("[data-faq-content]")!.classList.add("hidden");
          el.querySelector("[data-faq-icon-plus]")!.classList.remove("hidden");
          el.querySelector("[data-faq-icon-minus]")!.classList.add("hidden");
        });

        if (!isOpen) {
          content.classList.remove("hidden");
          plus.classList.add("hidden");
          minus.classList.remove("hidden");
        }
      });
    });

    const planToggle = document.querySelector("[data-plan-toggle]");
    const planDropdown = document.querySelector("[data-plan-dropdown]");
    const planTitle = document.querySelector("[data-plan-title]");
    const planChevron = document.querySelector("[data-plan-chevron]");

    if (planToggle && planDropdown) {
      planToggle.addEventListener("click", () => {
        const isHidden = planDropdown.classList.toggle("hidden");
        planToggle.setAttribute("aria-expanded", String(!isHidden));
        planChevron?.classList.toggle("rotate-180");
      });

      document.querySelectorAll("[data-select-plan]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const plan = (btn as HTMLElement).dataset.selectPlan!;
          const name = (btn as HTMLElement).dataset.planName!;
          if (planTitle) planTitle.textContent = name;

          document.querySelectorAll("[data-plan-content]").forEach((el) => {
            (el as HTMLElement).classList.toggle(
              "hidden",
              (el as HTMLElement).dataset.planContent !== plan,
            );
          });

          document.querySelectorAll("[data-select-plan]").forEach((b) => {
            (b as HTMLElement).classList.toggle(
              "text-light-blue-600",
              (b as HTMLElement).dataset.selectPlan === plan,
            );
            (b as HTMLElement).classList.toggle(
              "text-dark-600",
              (b as HTMLElement).dataset.selectPlan !== plan,
            );
          });

          planDropdown.classList.add("hidden");
          planToggle.setAttribute("aria-expanded", "false");
          planChevron?.classList.remove("rotate-180");
        });
      });
    }
  });
</script>
