---
import AppModal from "../../components/AppModal.astro";
import CtaLight from "../../components/CtaLight.astro";
import HeroSimple from "../../components/HeroSimple.astro";
import SvgIcon from "../../components/SvgIcon.astro";
import Layout from "../../layouts/Layout.astro";

interface Category {
  id: string;
  title: string;
  slug: string;
}

const categories: Category[] = [
  { id: "commodities", title: "Commodities", slug: "commodities" },
  { id: "crypto", title: "Crypto", slug: "crypto" },
  { id: "consumer", title: "Consumer", slug: "consumer" },
  {
    id: "filings-research",
    title: "Filings and Research",
    slug: "filings-research",
  },
  { id: "fixed-income", title: "Fixed Income", slug: "fixed-income" },
  { id: "forecasting", title: "Forecasting", slug: "forecasting" },
  { id: "fundamentals", title: "Fundamentals", slug: "fundamentals" },
  { id: "macroeconomy", title: "Macroeconomy", slug: "macroeconomy" },
  { id: "news", title: "News", slug: "news" },
  { id: "portfolio-risk", title: "Portfolio Risk", slug: "portfolio-risk" },
  {
    id: "prediction-markets",
    title: "Prediction Markets",
    slug: "prediction-markets",
  },
  { id: "sentiment", title: "Sentiment", slug: "sentiment" },
  {
    id: "trading-activity",
    title: "Trading activity",
    slug: "trading-activity",
