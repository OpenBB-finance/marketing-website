const allApps = categories
  .flatMap((cat) => {
    const apps = marketplaceApps[cat.slug];
    if (!apps) return [];
    return apps.map((app) => ({
      ...app,
      category: cat.title,
      categorySlug: cat.slug,
    }));
  })
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Layout
  title="OpenBB App Marketplace"
  description="Financial data apps from vetted providers, live inside the OpenBB Workspace. Find, trial, and connect new data sources without a sales cycle, an IT request, or a custom integration."
  navLight
>
  <main class="isolate bg-white">
    <HeroSimple
      label="openbb app marketplace"
      title={"The data you need,\nright where you work"}
      description="Financial data apps from vetted providers, live inside the OpenBB Workspace. Find, trial, and connect new data sources without a sales cycle, an IT request, or a custom integration."
      buttonText="Go to the Marketplace"
      buttonLink="https://pro.openbb.co/app?tab=apps-marketplace"
    />

    <!-- Mobile Navigation Toggle -->
    <div
      class="lg:hidden sticky top-0 z-40 bg-grey-50 border-b border-grey-200"
      data-mobile-cat-nav
    >
      <div class="px-4 sm:px-6">
        <div class="py-4">
          <p
            class="text-grey-500 body-sm-regular mb-4 pb-4 border-b border-grey-300"
          >
            Categories
          </p>
          <button
            type="button"
            data-mobile-cat-toggle
            class="flex items-center justify-between w-full text-left"
          >
            <span data-mobile-cat-label class="text-dark-600 body-md-bold">
              All
            </span>
            <svg
              class="w-5 h-5 text-dark-600 transition-transform duration-200 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              data-mobile-chevron
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <div
          data-mobile-cat-dropdown
          class="hidden border-t border-grey-200 bg-grey-50"
        >
          <nav class="py-2 max-h-64 overflow-y-auto">
            <button
              type="button"
              data-mobile-cat-btn="all"
              class="w-full text-left px-4 py-3 transition-colors duration-200 body-md-regular text-light-blue-600 hover:text-light-blue-600"
            >
              All
            </button>
            {
              categories.map((cat) => (
                <button
                  type="button"
                  data-mobile-cat-btn={cat.slug}
                  class="w-full text-left px-4 py-3 transition-colors duration-200 body-md-regular text-dark-600 hover:text-light-blue-600"
                >
                  {cat.title}
                </button>
              ))
            }
          </nav>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section id="marketplace-content">
      <div class="flex max-w-[1440px] mx-auto pr-5 lg:pr-[80px]">
        <!-- Desktop Sidebar -->
        <aside class="hidden lg:block w-[360px] flex-shrink-0">
          <div class="pt-[78px] pl-8 pr-8" data-sidebar-sticky>
            <h3
              class="text-grey-400 border-b border-grey-200 body-sm-regular mb-4 pb-2"
            >
              Categories
            </h3>
            <nav class="flex flex-col pb-8">
              <button
                type="button"
                data-sidebar-btn="all"
                class="w-full text-left py-2 transition-colors duration-200 body-sm-regular text-light-blue-600 hover:text-grey-300 cursor-pointer"
              >
                All
              </button>
              {
                categories.map((cat) => (
                  <button
                    type="button"
                    data-sidebar-btn={cat.slug}
                    class="w-full text-left py-2 transition-colors duration-200 body-sm-regular text-dark-600 hover:text-grey-300 cursor-pointer"
                  >
                    {cat.title}
                  </button>
                ))
              }
            </nav>
          </div>
        </aside>

        <!-- Content Area -->
        <div class="flex-1 min-w-0 py-10 md:py-16 lg:pl-10 pl-5">
          <!-- Search -->
          <div class="mb-8 lg:mb-10 relative">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-grey-400 pointer-events-none"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              data-search-input
              type="text"
              placeholder="Search"
              class="w-full bg-white border border-grey-200 text-dark-600 placeholder-grey-400 rounded-[4px] pl-9 pr-9 py-2 body-md-regular outline-none focus:border-light-blue-600 transition-colors"
            />
            <button
              type="button"
              data-search-clear
              class="absolute right-3 top-1/2 -translate-y-1/2 text-grey-400 hover:text-dark-600 hidden"
              aria-label="Clear search"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- No Results -->
          <div data-no-results class="hidden text-center py-12">
            <h3 class="text-dark-400 text-title-xs-bold mb-2">No apps found</h3>
            <p class="text-grey-600 body-sm-regular">
              Try adjusting your search terms
            </p>
          </div>

          <!-- App Grid -->
          <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-16 lg:mb-20"
            data-app-grid
          >
            {
              allApps.map((app: any, globalIndex: number) => {
                return (
                  <button
                    type="button"
                    data-app-card
                    data-app-category={app.categorySlug}
                    data-app-index={globalIndex}
                    data-app-title={app.title.toLowerCase()}
                    data-app-desc={app.description?.toLowerCase() || ""}
                    class="cursor-pointer group text-left border-b border-grey-200 app-card"
                  >
                    <div class="px-3 pt-5 pb-0">
                      <div class="aspect-[16/10] rounded-md flex items-center justify-center overflow-hidden transition-transform duration-300 ease-out group-hover:scale-[1.02]">
                        <img
                          src={app.image}
                          alt={app.imageAlt || app.title}
                          class="w-full h-full object-cover app-img-loading"
                          loading="lazy"
                          decoding="async"
                          onload="this.classList.add('app-img-loaded')"
                        />
                      </div>
                    </div>
                    <div class="px-3 pt-5 pb-5 flex items-start justify-between gap-3">
                      <div>
                        <p class="text-grey-400 uppercase text-[10px] font-bold tracking-wider mb-1">
                          {app.category}
                        </p>
                        <h3 class="text-dark-600 body-md-bold leading-[1.3] min-w-0 flex-1">
                          {app.title}
                        </h3>
                        <p class="text-dark-400 body-xs-regular mt-2 line-clamp-2">
                          {app.description}
                        </p>
                        <div class="mt-4 flex items-center gap-1 text-light-blue-600 body-xs-bold group-hover:text-light-blue-700 transition-colors">
                          <span>Learn more</span>
                          <svg
                            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M9 18l6-6-6-6" />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </button>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <CtaLight
      title="Want to list your app and reach<br />thousands of financial professionals?"
      description="Contact us to learn more about joining the OpenBB App Marketplace."
      buttonText="Contact us"
      buttonHref="/contact"
      buttonTarget="_self"
    />
  </main>
  <AppModal />
</Layout>

<script
  id="marketplace-apps-data"
  type="application/json"
  set:html={JSON.stringify(allApps)}
/>

<script>
  document.addEventListener("astro:page-load", () => {
    const dataEl = document.getElementById("marketplace-apps-data");
    if (!dataEl) return;

    const ac = new AbortController();
    const { signal } = ac;

    const appsData: any[] = JSON.parse(dataEl.textContent!);

    const modal = document.querySelector<HTMLElement>("[data-app-modal]")!;
    const overlay = modal.querySelector<HTMLElement>("[data-modal-overlay]")!;
    const prevBtn = modal.querySelector<HTMLElement>("[data-modal-prev]")!;
    const nextBtn = modal.querySelector<HTMLElement>("[data-modal-next]")!;
    const closeBtns = modal.querySelectorAll<HTMLElement>(
      "[data-modal-close], [data-modal-close-desktop]",
    );

    const mCategory = modal.querySelector<HTMLElement>(
      "[data-modal-category]",
    )!;
    const mCategoryDesktop = modal.querySelector<HTMLElement>(
      "[data-modal-category-desktop]",
    )!;
    const mTitleMobile = modal.querySelector<HTMLElement>(
      "[data-modal-title-mobile]",
    )!;
    const mTitleDesktop = modal.querySelector<HTMLElement>(
      "[data-modal-title-desktop]",
    )!;
    const mLogo = modal.querySelector<HTMLImageElement>("[data-modal-logo]")!;
    const mLogoDesktop = modal.querySelector<HTMLImageElement>(
      "[data-modal-logo-desktop]",
    )!;
    const mScreenshot = modal.querySelector<HTMLImageElement>(
      "[data-modal-screenshot]",
    )!;
    const mDescription = modal.querySelector<HTMLElement>(
      "[data-modal-description]",
    )!;
    const mButtons = modal.querySelector<HTMLElement>("[data-modal-buttons]")!;
    const mBtnGithub = modal.querySelector<HTMLAnchorElement>(
      "[data-modal-btn-github]",
    )!;
    const mBtnBlog = modal.querySelector<HTMLAnchorElement>(
      "[data-modal-btn-blog]",
    )!;

    // Dynamically create header blog buttons (marketplace page only)
    function createHeaderBlogBtn(
      classes: string,
      label: string,
    ): HTMLAnchorElement {
      const btn = document.createElement("a");
      btn.target = "_blank";
      btn.rel = "noopener noreferrer";
      btn.className = `hidden ${classes}`;
      btn.textContent = label;
      return btn;
    }

    // Mobile header blog button
    const mobileHeaderActions = modal.querySelector(
      ".md\\:hidden [data-marketplace-btn]",
    )?.parentElement;
    const mobileHeaderBlogBtn = createHeaderBlogBtn(
      "inline-flex items-center justify-center font-bold transition-colors duration-200 rounded-sm cursor-pointer px-2 py-1 text-[10px] uppercase bg-white text-dark-600 border border-grey-300 hover:bg-grey-50",
      "Blog post",
    );
    if (mobileHeaderActions) {
      const marketplaceBtn = mobileHeaderActions.querySelector(
        "[data-marketplace-btn]",
      );
      if (marketplaceBtn)
        marketplaceBtn.insertAdjacentElement("afterend", mobileHeaderBlogBtn);
    }

    // Desktop header blog button
    const desktopHeaderActions = modal.querySelector(
      ".hidden.md\\:flex [data-marketplace-btn]",
    )?.parentElement;
    const desktopHeaderBlogBtn = createHeaderBlogBtn(
      "inline-flex items-center justify-center font-medium transition-colors duration-200 rounded-sm cursor-pointer px-4 py-2 body-sm-medium bg-white text-dark-600 border border-grey-300 hover:bg-grey-50",
      "Read blog post",
    );
    if (desktopHeaderActions) {
      const marketplaceBtn = desktopHeaderActions.querySelector(
        "[data-marketplace-btn]",
      );
      if (marketplaceBtn)
        marketplaceBtn.insertAdjacentElement("afterend", desktopHeaderBlogBtn);
    }

    const mHeaderBlogBtns = [mobileHeaderBlogBtn, desktopHeaderBlogBtn];

    // Show and restyle marketplace buttons (marketplace page only)
    modal
      .querySelectorAll<HTMLAnchorElement>("[data-marketplace-btn]")
      .forEach((btn) => {
        btn.classList.remove(
          "hidden",
          "bg-white",
          "text-dark-600",
          "border",
          "border-grey-300",
          "hover:bg-grey-50",
        );
        btn.classList.add(
          "inline-flex",
          "bg-grey-750",
          "text-white",
          "hover:bg-grey-800",
        );
      });

    // Hide logos in modal on this page
    modal
      .querySelectorAll("[data-modal-logo], [data-modal-logo-desktop]")
      .forEach((el) => {
        (el as HTMLElement).style.display = "none";
      });
    const mBtnVideo = modal.querySelector<HTMLAnchorElement>(
      "[data-modal-btn-video]",
    )!;
    const mQuote = modal.querySelector<HTMLElement>("[data-modal-quote]")!;
    const mQuoteText = modal.querySelector<HTMLElement>(
      "[data-modal-quote-text]",
    )!;
    const mQuoteAuthor = modal.querySelector<HTMLElement>(
      "[data-modal-quote-author]",
    )!;

    const searchInput = document.querySelector<HTMLInputElement>(
      "[data-search-input]",
    )!;
    const searchClear = document.querySelector<HTMLElement>(
      "[data-search-clear]",
    )!;
    const noResults = document.querySelector<HTMLElement>("[data-no-results]")!;
    const cards = document.querySelectorAll<HTMLElement>("[data-app-card]");
    const sidebarBtns =
      document.querySelectorAll<HTMLElement>("[data-sidebar-btn]");
    const mobileCatToggle = document.querySelector<HTMLElement>(
      "[data-mobile-cat-toggle]",
    )!;
    const mobileCatDropdown = document.querySelector<HTMLElement>(
      "[data-mobile-cat-dropdown]",
    )!;
    const mobileCatLabel = document.querySelector<HTMLElement>(
      "[data-mobile-cat-label]",
    )!;
    const mobileCatBtns = document.querySelectorAll<HTMLElement>(
      "[data-mobile-cat-btn]",
    );

    let currentIndex = 0;
    let activeSlug = "";
    let savedScrollY = 0;
    let savedNavbarDisplay = "";

    function isDemoEntry(entry: any): boolean {
      const url = (entry?.url || "").toLowerCase();
      const label = (entry?.label || "").toLowerCase();
      return (
        url.includes("youtube.com") ||
        url.includes("youtu.be") ||
        label.includes("demo") ||
        label.includes("webinar")
      );
    }

    function getLinks(app: any) {
      let blogUrl = "";
      let videoUrl = "";
      const blogs = app.blog
        ? Array.isArray(app.blog)
          ? app.blog
          : [app.blog]
        : [];
      for (const b of blogs) {
        if (isDemoEntry(b)) {
          if (!videoUrl) videoUrl = b.url;
        } else {
          if (!blogUrl) blogUrl = b.url;
        }
      }
      if (app.blog2) {
        if (isDemoEntry(app.blog2)) {
          if (!videoUrl) videoUrl = app.blog2.url;
        } else {
          if (!blogUrl) blogUrl = app.blog2.url;
        }
      }
      return { blogUrl, videoUrl };
    }

    function populateModal(app: any) {
      mCategory.textContent = app.category;
      mCategoryDesktop.textContent = app.category;
      mTitleMobile.textContent = app.title;
      mTitleDesktop.textContent = app.title;

      mScreenshot.src = app.image;
      mScreenshot.alt = app.imageAlt || app.title;
      mDescription.textContent = app.description || "";

      const { blogUrl, videoUrl } = getLinks(app);
      const githubUrl = app.github?.url || "";
      const hasAny = githubUrl || videoUrl;

      if (hasAny) {
        mButtons.classList.remove("hidden");
        mButtons.classList.add("flex");
      } else {
        mButtons.classList.add("hidden");
        mButtons.classList.remove("flex");
      }

      if (githubUrl) {
        mBtnGithub.href = githubUrl;
        mBtnGithub.classList.remove("hidden");
        mBtnGithub.classList.add("inline-flex");
      } else {
        mBtnGithub.classList.add("hidden");
        mBtnGithub.classList.remove("inline-flex");
      }

      // Always hide bottom blog button on marketplace
      mBtnBlog.classList.add("hidden");
      mBtnBlog.classList.remove("inline-flex");

      if (blogUrl) {
        mHeaderBlogBtns.forEach((btn) => {
          btn.href = blogUrl;
          btn.classList.remove("hidden");
          btn.classList.add("inline-flex");
        });
      } else {
        mHeaderBlogBtns.forEach((btn) => {
          btn.classList.add("hidden");
          btn.classList.remove("inline-flex");
        });
      }

      if (videoUrl) {
        mBtnVideo.href = videoUrl;
        mBtnVideo.classList.remove("hidden");
        mBtnVideo.classList.add("inline-flex");
      } else {
        mBtnVideo.classList.add("hidden");
        mBtnVideo.classList.remove("inline-flex");
      }

      if (app.quote) {
        mQuote.classList.remove("hidden");
        mQuoteText.textContent = app.quote.text;
        const parts = [
          app.quote.author,
          app.quote.title,
          app.quote.company,
        ].filter(Boolean);
        mQuoteAuthor.textContent = parts.join(", ");
      } else {
        mQuote.classList.add("hidden");
      }

      const globalIdx = appsData.indexOf(app);
      prevBtn.style.display = globalIdx > 0 ? "" : "none";
      nextBtn.style.display = globalIdx < appsData.length - 1 ? "" : "none";
    }

    function toSlug(s: string) {
      return s.toLowerCase().replace(/\s+/g, "-");
    }

    function openModal(index: number) {
      currentIndex = index;
      const app = appsData[index];
      if (!app) return;
      populateModal(app);
      savedScrollY = window.scrollY;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.width = "100%";
      const navbar = document.querySelector<HTMLElement>("[data-navbar]");
      if (navbar) {
        savedNavbarDisplay = navbar.style.display;
        navbar.style.display = "none";
      }
      history.replaceState(
        null,
        "",
        `/solutions/marketplace?category=${activeSlug}&app=${toSlug(app.title)}`,
      );
    }

    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      const navbar = document.querySelector<HTMLElement>("[data-navbar]");
      if (navbar) navbar.style.display = savedNavbarDisplay;
      history.replaceState(
        null,
        "",
        `/solutions/marketplace?category=${activeSlug}`,
      );
      requestAnimationFrame(() => window.scrollTo(0, savedScrollY));
    }

    function navModal(dir: number) {
      const nextIndex = currentIndex + dir;
      if (nextIndex < 0 || nextIndex >= appsData.length) return;
      currentIndex = nextIndex;
      const nextApp = appsData[nextIndex];
      populateModal(nextApp);
      history.replaceState(
        null,
        "",
        `/solutions/marketplace?category=${activeSlug}&app=${toSlug(nextApp.title)}`,
      );
      modal.querySelector(".overflow-y-auto")?.scrollTo(0, 0);
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const idx = parseInt(card.dataset.appIndex || "0", 10);
        openModal(idx);
      });
    });

    closeBtns.forEach((btn) => btn.addEventListener("click", closeModal));
    overlay.addEventListener("click", closeModal);
    prevBtn.addEventListener("click", () => navModal(-1));
    nextBtn.addEventListener("click", () => navModal(1));

    document.addEventListener(
      "keydown",
      (e) => {
        if (!modal.classList.contains("flex")) return;
        if (e.key === "Escape") closeModal();
        else if (e.key === "ArrowLeft") navModal(-1);
        else if (e.key === "ArrowRight") navModal(1);
      },
      { signal },
    );

    let touchStartX = 0;
    let touchStartY = 0;
    modal.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true },
    );
    modal.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 2)
          navModal(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    function updateBorders() {
      const visibleCards = Array.from(cards).filter(
        (c) => c.style.display !== "none",
      );
      visibleCards.forEach((c, i) => {
        c.style.borderRight = "";
        const isDesktop = window.innerWidth >= 1024;
        const isTablet = window.innerWidth >= 768 && window.innerWidth < 1024;

        if (isDesktop && ((i + 1) % 3 === 0 || i === visibleCards.length - 1)) {
          c.style.borderRight = "none";
        } else if (
          isTablet &&
          ((i + 1) % 2 === 0 || i === visibleCards.length - 1)
        ) {
          c.style.borderRight = "none";
        } else if (window.innerWidth < 768) {
          c.style.borderRight = "none";
        }
      });
    }

    window.addEventListener(
      "resize",
      () => {
        if (cards.length > 0) updateBorders();
      },
      { signal, passive: true },
    );

    function applyFilters() {
      const q = searchInput.value.toLowerCase().trim();
      searchClear.classList.toggle("hidden", !q);

      let anyVisible = false;
      cards.forEach((card) => {
        const matchCategory =
          activeSlug === "all" || card.dataset.appCategory === activeSlug;
        const matchSearch =
          !q ||
          card.dataset.appTitle!.includes(q) ||
          card.dataset.appDesc!.includes(q);

        if (matchCategory && matchSearch) {
          card.style.display = "";
          anyVisible = true;
        } else {
          card.style.display = "none";
        }
      });

      noResults.classList.toggle("hidden", anyVisible);
      updateBorders();
    }

    function setActiveSidebar(slug: string) {
      activeSlug = slug;
      sidebarBtns.forEach((btn) => {
        const isActive = btn.dataset.sidebarBtn === slug;
        btn.classList.toggle("text-light-blue-600", isActive);
        btn.classList.toggle("text-dark-600", !isActive);
      });
      mobileCatBtns.forEach((btn) => {
        const isActive = btn.dataset.mobileCatBtn === slug;
        btn.classList.toggle("text-light-blue-600", isActive);
        btn.classList.toggle("text-dark-600", !isActive);
      });
      if (slug === "all") {
        if (mobileCatLabel) mobileCatLabel.textContent = "All";
      } else {
        const cat = appsData.find((a) => a.categorySlug === slug);
        if (cat && mobileCatLabel) mobileCatLabel.textContent = cat.category;
      }
      applyFilters();
    }

    searchInput.addEventListener("input", applyFilters);
    searchClear.addEventListener("click", () => {
      searchInput.value = "";
      applyFilters();
      searchInput.focus();
    });

    sidebarBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        setActiveSidebar(btn.dataset.sidebarBtn!);
        const content = document.getElementById("marketplace-content");
        if (content)
          content.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    mobileCatToggle?.addEventListener("click", () => {
      const open = !mobileCatDropdown.classList.contains("hidden");
      mobileCatDropdown.classList.toggle("hidden", open);
      const chevron = mobileCatToggle.querySelector("[data-mobile-chevron]");
      if (chevron)
        (chevron as HTMLElement).style.transform = open ? "" : "rotate(180deg)";
    });

    mobileCatBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        mobileCatDropdown.classList.add("hidden");
        const chevron = mobileCatToggle.querySelector("[data-mobile-chevron]");
        if (chevron) (chevron as HTMLElement).style.transform = "";
        setActiveSidebar(btn.dataset.mobileCatBtn!);
        const content = document.getElementById("marketplace-content");
        if (content)
          content.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    const params = new URLSearchParams(location.search);
    const catParam = params.get("category");
    const appParam = params.get("app");

    if (catParam) {
      setActiveSidebar(catParam);
    } else {
      setActiveSidebar("all");
    }

    if (appParam && catParam) {
      const idx = appsData.findIndex(
        (a) => toSlug(a.title) === appParam && a.categorySlug === catParam,
      );
      if (idx !== -1) openModal(idx);
    }

    const sidebarEl = document.querySelector<HTMLElement>(
      "[data-sidebar-sticky]",
    );
    if (sidebarEl) {
      const aside = sidebarEl.parentElement!;
      const flexContainer = aside.parentElement!;
      const topGap = 16;
      let startY = 0;

      function calcStartY() {
        startY = aside.getBoundingClientRect().top + window.scrollY;
      }
      calcStartY();

      function updateSidebar() {
        const sidebarH = sidebarEl!.offsetHeight;
        const flexBottom = flexContainer.offsetTop + flexContainer.offsetHeight;
        const stopY = flexBottom - sidebarH - topGap;

        if (window.scrollY > stopY) {
          sidebarEl!.style.position = "relative";
          sidebarEl!.style.top = stopY - startY + topGap + "px";
          sidebarEl!.style.width = "";
        } else if (window.scrollY > startY - topGap) {
          sidebarEl!.style.position = "fixed";
          sidebarEl!.style.top = topGap + "px";
          sidebarEl!.style.width = aside.offsetWidth + "px";
        } else {
          sidebarEl!.style.position = "";
          sidebarEl!.style.top = "";
          sidebarEl!.style.width = "";
        }
      }

      window.addEventListener("scroll", updateSidebar, {
        signal,
        passive: true,
      });
      window.addEventListener(
        "resize",
        () => {
          calcStartY();
          updateSidebar();
        },
        { signal, passive: true },
      );
      updateSidebar();
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        ac.abort();
        if (modal.classList.contains("flex")) {
          document.body.style.overflow = "";
          document.body.style.position = "";
          document.body.style.top = "";
          document.body.style.width = "";
        }

        // Restore marketplace buttons to original hidden/outlined state
        modal
          .querySelectorAll<HTMLAnchorElement>("[data-marketplace-btn]")
          .forEach((btn) => {
            btn.classList.add(
              "hidden",
              "bg-white",
              "text-dark-600",
              "border",
              "border-grey-300",
              "hover:bg-grey-50",
            );
            btn.classList.remove(
              "inline-flex",
              "bg-grey-750",
              "text-white",
              "hover:bg-grey-800",
            );
          });

        // Restore logos
        modal
          .querySelectorAll("[data-modal-logo], [data-modal-logo-desktop]")
          .forEach((el) => {
            (el as HTMLElement).style.display = "";
          });

        // Remove injected header blog buttons
        mHeaderBlogBtns.forEach((btn) => btn.remove());
      },
      { once: true },
    );
  });
</script>

<style>
  .app-card {
    border-right: 1px solid var(--color-grey-200);
  }
  .app-img-loading {
    opacity: 0;
  }
  .app-img-loaded {
    opacity: 1;
    transition:
      opacity 0.5s ease-out,
      transform 0.3s ease;
  }
</style>
