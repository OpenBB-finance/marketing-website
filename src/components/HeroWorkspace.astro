---
import Button from "./Button.astro";
import SvgIcon from "./SvgIcon.astro";

interface Props {
  title: string;
  description: string;
  buttonText?: string;
  buttonLink?: string;
  buttonDataOpenModal?: string;
  imageSrc: string;
  imageAlt: string;
  features?: string[];
}

const {
  title,
  description,
  buttonText = "Start now",
  buttonLink = "https://pro.openbb.co/register",
  buttonDataOpenModal,
  imageSrc,
  imageAlt,
  features = [],
} = Astro.props;

const titleLines = title.split("\n");
const descriptionLines = description.split("\n");
---

<section class="relative overflow-hidden bg-[linear-gradient(to_bottom,#FFFFFF,rgba(51,187,255,0.2))] pt-24 md:pt-32 lg:pt-40" data-hero-workspace data-nav-theme="light">
  <div class="page-container">
    <div class="flex flex-col items-center text-center gap-6 max-w-6xl mx-auto">
      <h1
        class="text-title-s-medium md:text-[56px] md:font-medium md:font-manrope md:leading-[120%] text-dark-800 opacity-0 translate-y-4 transition-all duration-700"
        data-hero-ws-title
      >
        {titleLines.map((line, i) => (
          <Fragment>
            {i > 0 && <br class="hidden md:block" />}
            {i > 0 && <span class="md:hidden">{" "}</span>}
            {line}
          </Fragment>
        ))}
      </h1>
      <p
        class="body-md-regular md:body-lg-regular text-dark-400 max-w-5xl opacity-0 translate-y-4 transition-all duration-700"
        data-hero-ws-desc
      >
        {descriptionLines.map((line, i) => (
          <Fragment>
            {i > 0 && <span class="hidden md:inline"><br /></span>}
            {i > 0 && <span class="md:hidden"> </span>}
            {line}
          </Fragment>
        ))}
      </p>
      <div class="opacity-0 translate-y-4 transition-all duration-700 w-full md:w-auto" data-hero-ws-btn data-open-modal={buttonDataOpenModal}>
        {buttonDataOpenModal ? (
          <Button variant="secondary" class="w-full md:w-auto cursor-pointer" type="button">
            {buttonText}
          </Button>
        ) : (
          <Button variant="secondary" href={buttonLink} target="_blank" rel="noopener noreferrer" class="w-full md:w-auto">
            {buttonText}
          </Button>
        )}
      </div>
      {features.length > 0 && (
        <div class="flex flex-wrap gap-5 justify-center mt-2 opacity-0 translate-y-4 transition-all duration-700" data-hero-ws-features>
          {features.map((feat) => (
            <div class="flex gap-2 items-center">
              <SvgIcon name="workspace-tick" class="w-5 h-5" />
              <span class="text-dark-50 body-md-regular">{feat}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="relative mt-6 md:mt-10 overflow-hidden max-h-[500px] md:max-h-[600px]">
    <div class="page-container">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="w-full h-auto rounded-t-lg shadow-[0_8px_40px_rgba(0,0,0,0.12),0_2px_12px_rgba(0,0,0,0.06)]"
        loading="eager"
        fetchpriority="high"
        data-hero-ws-image
      />
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector("[data-hero-workspace]");
    if (!section) return;

    const ac = new AbortController();
    const { signal } = ac;

    const els = [
      section.querySelector("[data-hero-ws-title]"),
      section.querySelector("[data-hero-ws-desc]"),
      section.querySelector("[data-hero-ws-btn]"),
      section.querySelector("[data-hero-ws-features]"),
    ].filter(Boolean) as HTMLElement[];
    setTimeout(() => {
      els.forEach((el, i) => {
        setTimeout(() => {
          el.style.opacity = "1";
          el.style.transform = "translateY(0)";
        }, i * 180);
      });
    }, 300);

    const img = section.querySelector("[data-hero-ws-image]") as HTMLElement;
    if (img) {
      const startOffset = 40;
      const update = () => {
        const y = window.scrollY;
        const offset = Math.max(startOffset - y * 0.25, 0);
        img.style.transform = `translateY(${offset}px)`;
      };
      update();
      let ticking = false;
      window.addEventListener("scroll", () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        }
      }, { signal, passive: true });
    }

    document.addEventListener("astro:before-swap", () => { ac.abort(); }, { once: true });
  });
</script>
