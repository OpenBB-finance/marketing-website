---
import { Image } from "astro:assets";
import heroDesktop from "../assets/images/hero_homepage.png";
import heroMobile from "../assets/images/hero_homepage_mobile.png";
import Button from "./Button.astro";

interface Props {
  bannerTitle?: string;
  bannerUrl?: string;
}

const { bannerTitle, bannerUrl } = Astro.props;
const eyebrowText = bannerTitle || "Latest Updates";
const eyebrowHref = bannerUrl || "/blog";
const isExternal = eyebrowHref.startsWith("http");
---

<section class="relative pt-28 lg:pt-[440px] pb-16 lg:pb-20 overflow-hidden w-full bg-dark-800" data-hero-home>
  <div class="absolute inset-0 z-0 hidden md:block">
    <Image
      src={heroDesktop}
      alt="Brooklyn Bridge and NYC Skyline"
      class="w-full h-full object-cover object-top duration-[3s] transition-transform opacity-0"
      loading="eager"
      fetchpriority="high"
      quality={90}
      widths={[768, 1280, 1920, 2560, 3840]}
      sizes="100vw"
      data-hero-bg-desktop
    />
  </div>

  <div class="absolute inset-0 z-0 md:hidden">
    <Image
      src={heroMobile}
      alt="Mobile Hero Background"
      class="w-full h-full object-cover object-center duration-[3s] transition-transform opacity-0"
      loading="eager"
      fetchpriority="high"
      quality={90}
      widths={[375, 640, 768, 1080]}
      sizes="100vw"
      data-hero-bg-mobile
    />
  </div>



  <div class="relative z-10 mx-auto px-8 md:px-4 max-w-7xl">
    <div class="md:grid md:grid-cols-2 md:gap-16 md:items-start mb-12">
      <div class="text-center md:text-left">
        <div class="mb-6 md:mb-8 flex justify-center md:justify-start opacity-0 translate-y-4 transition-all duration-700" data-hero-el>
          <a
            href={eyebrowHref}
            {...isExternal ? { target: "_blank", rel: "noreferrer noopener" } : {}}
            class="inline-flex items-center gap-2 px-3 py-1 rounded-lg border border-light-blue-200 text-white transition-colors group hover:border-light-blue-500 max-w-xs overflow-hidden"
          >
            <span class="body-xs-medium truncate">{eyebrowText}</span>
            <svg class="w-4 h-4 group-hover:text-light-blue-600 transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </a>
        </div>
        <h1 class="text-title-m-bold md:text-[64px] md:font-bold md:font-manrope md:leading-[110%] md:tracking-[0%] text-white opacity-0 translate-y-4 transition-all duration-700" data-hero-el>
          Build your own <br /><span class="whitespace-nowrap">financial workspace</span>
        </h1>
      </div>

      <div class="text-center md:text-left flex flex-col items-center md:items-start md:justify-end md:h-full mt-4 md:mt-0 max-w-xl mx-auto md:ml-auto">
        <p class="body-md-regular md:body-lg-regular text-grey-100 mb-6 max-w-lg opacity-0 translate-y-4 transition-all duration-700" data-hero-el>
          The workspace where investment teams bring their data, workflows, and AI together. Under your control.
        </p>
        <div class="opacity-0 translate-y-4 transition-all duration-700 w-full md:w-auto" data-hero-el>
          <Button variant="accent" href="/products/workspace" class="w-full md:w-auto">
            Learn more
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const hero = document.querySelector("[data-hero-home]");
    if (hero) {
      const bgDesktop = hero.querySelector("[data-hero-bg-desktop]") as HTMLElement;
      const bgMobile = hero.querySelector("[data-hero-bg-mobile]") as HTMLElement;
      [bgDesktop, bgMobile].forEach((bg) => {
        if (bg) {
          bg.style.opacity = "1";
          bg.style.transform = "scale(1.05)";
          setTimeout(() => { bg.style.transform = "scale(1)"; }, 100);
        }
      });

      const els = hero.querySelectorAll("[data-hero-el]");
      setTimeout(() => {
        els.forEach((el, i) => {
          setTimeout(() => {
            (el as HTMLElement).style.opacity = "1";
            (el as HTMLElement).style.transform = "translateY(0)";
          }, i * 180);
        });
      }, 500);
    }
  });
</script>
