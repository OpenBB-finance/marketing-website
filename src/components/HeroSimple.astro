---
import Button from "./Button.astro";
import SvgIcon from "./SvgIcon.astro";

interface Props {
  title: string;
  description: string;
  label?: string;
  icon?: string;
  iconSrc?: string;
  iconAlt?: string;
  buttonText?: string;
  buttonLink?: string;
  buttonDataModal?: boolean;
  hideButton?: boolean;
}

const {
  title,
  description,
  label,
  icon,
  iconSrc,
  iconAlt = "",
  buttonText = "Start now",
  buttonLink = "https://pro.openbb.co/register",
  buttonDataModal = false,
  hideButton = false,
} = Astro.props;

const titleLines = title.split("\n");
const descriptionLines = description.split("\n");
---

<section class="bg-white overflow-hidden w-full" data-hero-simple>
  <div class="page-container">
    <div class="flex flex-col items-center py-24 lg:py-32 text-center">
      {iconSrc && (
        <div
          class="flex items-center justify-center mb-2 opacity-0 translate-y-4 transition-all duration-700"
          data-hero-simple-icon
        >
          <img
            src={iconSrc}
            alt={iconAlt}
            class="w-[100px] lg:w-[140px]"
            fetchpriority="high"
          />
        </div>
      )}
      {icon && !iconSrc && (
        <div
          class="w-12 h-12 bg-light-blue-600 rounded-full flex items-center justify-center mb-6 opacity-0 translate-y-4 transition-all duration-700"
          data-hero-simple-icon
        >
          <SvgIcon name={icon} class="w-6 h-6 text-white" />
        </div>
      )}
      {label && (
        <p
          class="text-sm font-medium leading-[22px] tracking-[0.1em] text-light-blue-600 uppercase mb-4 opacity-0 translate-y-4 transition-all duration-700"
          data-hero-simple-label
        >
          {label}
        </p>
      )}
      <h1
        class="text-title-s-medium md:text-[56px] md:font-medium md:font-manrope md:leading-[120%] text-dark-800 max-w-3xl opacity-0 translate-y-4 transition-all duration-700"
        data-hero-simple-title
      >
        {titleLines.map((line, i) => (
          <Fragment>
            {i > 0 && <br />}
            {line}
          </Fragment>
        ))}
      </h1>
      <p
        class="body-md-regular md:body-lg-regular text-dark-400 max-w-4xl mt-6 opacity-0 translate-y-4 transition-all duration-700"
        data-hero-simple-desc
      >
        {descriptionLines.map((line, i) => (
          <Fragment>
            {i > 0 && <span class="hidden md:inline"><br /></span>}
            {line}
          </Fragment>
        ))}
      </p>
      {!hideButton && (
      <div class="mt-8 opacity-0 translate-y-4 transition-all duration-700 w-full md:w-auto" data-hero-simple-btn>
        {buttonDataModal ? (
          <button
            type="button"
            data-open-modal="contact"
            class="inline-flex items-center justify-center font-medium transition-colors duration-200 rounded-sm cursor-pointer px-5 py-2.5 body-sm-medium bg-grey-750 text-white hover:bg-grey-800 w-full md:w-auto"
          >
            {buttonText}
          </button>
        ) : (
          <Button variant="secondary" href={buttonLink} target="_blank" rel="noopener noreferrer" class="w-full md:w-auto">
            {buttonText}
          </Button>
        )}
      </div>
      )}
    </div>
  </div>
  <div class="page-container"><div class="w-full h-px bg-grey-200"></div></div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const hero = document.querySelector("[data-hero-simple]");
    if (hero) {
      const els = [
        hero.querySelector("[data-hero-simple-icon]"),
        hero.querySelector("[data-hero-simple-label]"),
        hero.querySelector("[data-hero-simple-title]"),
        hero.querySelector("[data-hero-simple-desc]"),
        hero.querySelector("[data-hero-simple-btn]"),
      ].filter(Boolean) as HTMLElement[];
      setTimeout(() => {
        els.forEach((el, i) => {
          setTimeout(() => {
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          }, i * 180);
        });
      }, 300);
    }
  });
</script>
