                </div>
              </div>
              <div class="flex gap-[120px]">
                {
                  solutionPosts.map((post) => (
                    <a
                      href={post.url}
                      class="flex flex-col gap-4 group w-[280px] shrink-0"
                    >
                      <img
                        src={post.imgUrl}
                        alt={post.title}
