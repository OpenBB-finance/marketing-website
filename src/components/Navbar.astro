        </button>
        <div
          class="absolute left-0 right-0 top-full z-50 bg-white shadow-[0_2px_10px_rgba(0,0,0,0.2)] opacity-0 invisible transition-[opacity,visibility] duration-200"
          data-dropdown-panel
