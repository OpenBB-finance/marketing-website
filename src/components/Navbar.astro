                  <div class="flex flex-col gap-6">
                    {
                      resourceItems.map((item) => (
                        <a
                          href={item.url}
                          class="inline-flex items-center gap-1 text-sm text-dark-400 hover:text-[#069] transition-colors"
                          target={item.external ? "_blank" : undefined}
                          rel={
                            item.external ? "noopener noreferrer" : undefined
                          }
                        >
                          {item.label}
                          {item.external && (
                            <SvgIcon name="external-nav" class="w-3 h-3" />
                          )}
                        </a>
                      ))
                    }
                  </div>
                </div>
                <div class="w-[280px] shrink-0">
                  <span class="text-lg font-bold text-dark-600 block mb-6"
                    >Comparison</span
                  >
                  <div class="flex flex-col gap-6">
                    {
                      comparisonItems.map((item) => (
                        <a
                          href={item.url}
                          class="text-sm text-dark-400 hover:text-[#069] transition-colors"
                        >
                          {item.label}
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
              {
                resourcePosts.map((post) => (
                  <a
                    href={post.url}
                    class="flex flex-col gap-4 group w-[280px] shrink-0"
                  >
                    <img
                      src={post.imgUrl}
                      alt={post.title}
                      class="w-[280px] h-[186px] object-cover rounded-md"
                      loading="lazy"
                    />
                    <span class="text-dark-400 text-[10px] uppercase tracking-[0.1em]">
                      {post.date} — {post.timeToRead} MIN
                    </span>
                    <span class="body-xs-bold text-dark-600 line-clamp-2">
                      {post.title}
                    </span>
                    <span class="inline-flex items-center gap-2 text-xs font-medium text-dark-800 group-hover:gap-3 transition-all">
                      {post.cta || "Read post"}
                      <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m9 18 6-6-6-6"
                        />
                      </svg>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <a
        href="/pricing"
        class="py-2 body-sm-regular transition-colors duration-300 cursor-pointer"
        data-nav-item>Pricing</a
