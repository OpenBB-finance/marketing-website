---
import { featuredVideo } from "../data/videos";
import {
  calculateTimeToRead,
  directusAssetUrl,
  formatDate,
  getPublishedPosts,
} from "../lib/directus";
import Button from "./Button.astro";
import SvgIcon from "./SvgIcon.astro";

const productCommercialItems = [
  { label: "OpenBB Workspace", url: "/products/workspace" },
  { label: "Snowflake Native App", url: "/products/snowflake" },
  { label: "Security", url: "/security" },
];

const productOpenSourceItems = [
  { label: "Open Data Platform (ODP)", url: "/products/odp" },
];

const solutionAudienceItems = [
  { label: "Buy-Side", url: "/buy-side" },
  { label: "AI Vendor", url: "/ai-vendor" },
];

const resourceItems = [
  { label: "Blog", url: "/blog" },
  { label: "Videos", url: "/videos" },
  { label: "About", url: "/company/about" },
  { label: "Documentation", url: "https://docs.openbb.co/", external: true },
];

const comparisonItems = [
  { label: "Streamlit", url: "/comparison/streamlit" },
  { label: "Tableau", url: "/comparison/tableau" },
  { label: "Power BI", url: "/comparison/power-bi" },
];

type NavPost = {
  title: string;
  url: string;
  date: string;
  timeToRead: number;
  imgUrl: string;
  cta?: string;
};
let navPosts: NavPost[] = [];
let solutionPosts: NavPost[] = [];
let resourcePosts: NavPost[] = [];
const solutionSlugs = [
  "introducing-the-openbb-app-marketplace",
  "introducing-workspace-mcp",
];
const imageOverrides: Record<string, string> = {
  "openbb-launches-openbb-workspace-as-a-snowflake-native-app-on-snowflake-marketplace":
    "9e630beb-c59c-4cc5-a702-e186a0c0db87",
  "quantly-openbb-bringing-multi-step-research-workflows-into-openbb":
    "789cf660-e25c-4761-a687-737bdc3c3437",
  "bring-proprietary-tools-into-openbb-workspace-with-the-new-html-widget":
    "5a0188c9-30a2-432b-9af0-ddab167f853d",
  "open-portfolio-a-suite-for-asset-managers-on-openbb":
    "e90b818a-1e12-4372-bf45-80faab989a1a",
  "openbb-the-interface-that-makes-mcp-work-for-financial-workflows":
    "6fda9740-b80a-4bda-8fea-b841fa765dee",
};
try {
  const allPosts = await getPublishedPosts();
  const toNavPost = (p: (typeof allPosts)[0]): NavPost => ({
    title: p.title,
    url: `/blog/${p.slug}`,
    date: formatDate(new Date(p.publishDate)),
    timeToRead: calculateTimeToRead(p.body),
    imgUrl: imageOverrides[p.slug]
      ? directusAssetUrl(imageOverrides[p.slug])
      : directusAssetUrl(p.cover),
  });
  const toSlug = (s: string) => s.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-");
  
  const liteMatch = allPosts.find((p) => p.slug === "introducing-openbb-workspace-lite-for-small-investment-teams" || p.title.toLowerCase().includes("lite"));
  
  const videoPost: NavPost = {
    title: featuredVideo.title,
    url: `/videos/${toSlug(featuredVideo.title)}`,
    date: formatDate(new Date(featuredVideo.date)),
    timeToRead: Number.parseInt(featuredVideo.duration, 10) || 12,
    imgUrl: `https://img.youtube.com/vi/${featuredVideo.id}/maxresdefault.jpg`,
    cta: "Watch demo"
  };

  navPosts = [];
  if (liteMatch) navPosts.push(toNavPost(liteMatch));
  navPosts.push(videoPost);
  solutionPosts = solutionSlugs
    .map((slug) => allPosts.find((p) => p.slug === slug))
    .filter((p): p is (typeof allPosts)[0] => p !== undefined)
    .map(toNavPost);
  resourcePosts = [videoPost];
} catch {}
---

<div class="fixed top-0 left-0 right-0 z-50" data-navbar>
  <nav
    class="hidden lg:flex items-center justify-between w-full px-[120px] py-4 transition-[transform,background-color,backdrop-filter] duration-300"
    data-desktop-nav
  >
    <a
      href="/"
      class="flex-shrink-0 max-w-[200px] transition-colors duration-300"
      data-nav-item
      data-nav-logo
    >
      <svg
        viewBox="0 0 126 34"
        width="126"
        height="34"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-labelledby="openbb-logo-desktop"
      >
        <title id="openbb-logo-desktop">OpenBB</title>
        <g fill="currentColor">
