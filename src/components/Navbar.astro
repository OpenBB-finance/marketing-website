            d="M60.707 1.416h-9.285v4.25h9.285v1.42h-7.854v4.25h9.283V1.423h-1.428l-.001-.007Zm0 7.793v.707H54.28V8.5h6.427v.709Zm0-5.668v.71h-7.854V2.831h7.855l-.001.71ZM69.99 11.333h2.852V7.087H64.99V5.671h9.285V1.42H63.562v9.913h6.428Zm-5-7.791v-.709h7.852V4.25H64.99v-.709Zm2.858 6.375H64.99V8.5h6.438v1.417h-3.58ZM63.563 0h-1.428v1.416h1.428V0ZM78.519 22.72v8.459l-.712-.704-.71-.706-.71-.704-.71-.706-.712-.704-.712-.705-.71-.704-.71-.706-.71-.706-.712-.704-.71-.704-.711-.705h-1.422V33.998h1.422V24.834l.711.706.71.706.711.704.71.705.712.704.71.706.71.704.712.706.71.704.712.705.71.706.71.704.71.704h.712V22.721H78.52ZM101.402 26.95h-1.421v-4.23h-8.528V34h11.374v-7.057h-1.422l-.003.007Zm-8.528-.71v-2.11h5.685v2.82h-5.685v-.71Zm8.528 2.82v3.528h-8.528v-4.227h8.528v.699ZM124.986 26.95h-2.131v-4.23h-8.529V34h11.37v-7.057l-.71.007Zm-9.239-.71v-2.11h5.687v2.82h-5.687v-.71Zm8.53 2.82v3.528h-8.53v-4.227h8.53v.699ZM55.732 22.72H45.78v11.278H57.15V32.59H47.204v-2.821H55.728v-1.41h-8.524V24.13H57.15V22.721h-1.418ZM9.95 22.72H.003V34h11.372V22.72H9.95Zm0 2.116v7.754H1.423v-8.46H9.95v.706ZM32.855 22.721h-9.949v11.28h1.422V29.77h9.948v-7.057h-1.421v.008Zm0 2.116v3.528h-8.527v-4.234h8.527v.706Z"
          ></path>
        </g>
      </svg>
    </a>
    <div class="flex-1"></div>
    <div class="flex items-center gap-6">
      <div data-dropdown data-dropdown-mega>
        <button
          type="button"
          class="flex items-center gap-1 py-1 px-3 rounded-full body-sm-regular transition-[background-color,color] duration-200 cursor-pointer"
          data-nav-item
          data-dropdown-trigger
          aria-haspopup="true"
          aria-expanded="false"
        >
          Product
          <svg
            class="w-4 h-4 transition-transform duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div
          class="absolute left-0 right-0 top-full z-50 bg-white shadow-[0_2px_10px_rgba(0,0,0,0.2)] opacity-0 invisible transition-[opacity,visibility] duration-200"
          data-dropdown-panel
        >
          <div class="max-w-[1440px] mx-auto px-[80px] xl:px-[180px] py-[60px]">
            <div class="flex items-start justify-between">
              <div class="w-[280px] shrink-0">
                <span class="text-lg font-bold text-dark-600 block mb-6"
                  >Product</span
                >
                <div class="flex flex-col gap-6">
                  <span
                    class="text-[10px] font-semibold uppercase tracking-[0.1em] text-light-blue-700"
                    >Commercial</span
                  >
                  {
                    productCommercialItems.map((item) => (
                      <a
                        href={item.url}
                        class="text-sm text-dark-400 hover:text-[#069] transition-colors"
                      >
                        {item.label}
                      </a>
                    ))
                  }
                  <div class="border-t border-grey-200"></div>
                  <span
                    class="text-[10px] font-semibold uppercase tracking-[0.1em] text-light-blue-700"
                    >Open Source</span
                  >
                  {
                    productOpenSourceItems.map((item) => (
                      <a
                        href={item.url}
                        class="text-sm text-dark-400 hover:text-[#069] transition-colors"
                      >
                        {item.label}
                      </a>
                    ))
                  }
                </div>
              </div>
              <div class="flex gap-[120px]">
                {
                  navPosts.map((post) => (
                    <a
                      href={post.url}
                      class="flex flex-col gap-4 group w-[280px] shrink-0"
                    >
                      <img
                        src={post.imgUrl}
                        alt={post.title}
                        class="w-[280px] h-[186px] object-cover rounded-md"
