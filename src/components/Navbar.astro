    <div class="flex items-center gap-4">
      <button data-partner-trigger class="BB-Button inline-flex items-center justify-center gap-2 rounded-sm font-normal ring-offset-white focus-visible:outline-none focus-visible:ring-4 disabled:pointer-events-none transition cursor-pointer body-sm-medium h-10 px-4 nav-partner-btn whitespace-nowrap">
        Become a Partner
      </button>
      <a
        href="https://pro.openbb.co/login"
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer"
      >
        <Button variant="accent" class="whitespace-nowrap">Go to Workspace</Button>
