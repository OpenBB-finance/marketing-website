            type="button"
            class="w-full py-8 text-left flex items-center justify-between body-lg-regular text-dark-600 cursor-pointer"
            data-mobile-accordion-trigger
          >
            Resources
            <svg
              class="w-5 h-5 text-dark-400 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
            >
          </button>
          <div
            class="hidden border-t border-light-blue-600 pt-4 pb-2"
            data-mobile-accordion-content
          >
            <span
              class="body-xs-regular text-dark-400 uppercase tracking-[0.1em] mb-3 px-2 block"
              >Resources</span
            >
            <div class="space-y-1">
              {
                resourceItems.map((item) => (
                  <a
                    href={item.url}
                    class="flex items-center gap-1 py-3 px-2 body-sm-bold text-dark-600 hover:bg-grey-50 rounded transition-colors"
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    data-mobile-link
                  >
                    {item.label}
                    {item.external && (
                      <SvgIcon
                        name="external-nav"
                        class="w-3 h-3 text-dark-400"
                      />
                    )}
                  </a>
                ))
              }
            </div>
            <span
              class="body-xs-regular text-dark-400 uppercase tracking-[0.1em] mb-3 mt-6 px-2 block"
              >Comparison</span
            >
            <div class="space-y-1">
              {
                comparisonItems.map((item) => (
                  <a
                    href={item.url}
                    class="block py-3 px-2 body-sm-bold text-dark-600 hover:bg-grey-50 rounded transition-colors"
                    data-mobile-link
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <a
          href="/pricing"
          class="block py-8 body-lg-regular text-dark-600 hover:text-dark-400 transition-colors"
          data-mobile-link>Pricing</a
        >
      </div>
      <div
        class="shrink-0 px-6 pt-4 pb-4 flex flex-col gap-3 border-t border-grey-200"
      >
        <div data-partner-trigger class="w-full cursor-pointer">
          <Button variant="outlined" class="w-full pointer-events-none">Become a Partner</Button>
        </div>
        <a
          href="https://pro.openbb.co/login"
          target="_blank"
          rel="noopener noreferrer"
          data-mobile-link
        >
          <Button variant="accent" class="w-full">Go to Workspace</Button>
        </a>
      </div>
    </div>
  </div>
</div>

<div
  id="partner-modal"
  class="fixed inset-0 z-[100] hidden flex-col items-center justify-center p-4 transition-opacity duration-300 opacity-0 pointer-events-none"
>
  <div
    id="partner-modal-bg"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm cursor-pointer"
  ></div>
  <div class="relative w-full max-w-xl bg-white rounded-xl shadow-2xl overflow-hidden z-10 transition-transform duration-300 scale-95 flex flex-col" id="partner-modal-content">
    <div class="flex justify-end p-4 pb-0 shrink-0">
      <button
        id="partner-modal-close"
        class="text-grey-400 hover:text-grey-900 transition-colors bg-white rounded-full"
        aria-label="Close modal"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="relative w-full h-[650px] max-h-[80dvh]">
      <iframe
        src="https://app.formbricks.com/s/cms3erjhmnwz901shu03176vk?embed=true"
        frameborder="0" class="absolute inset-0 w-full h-full border-0">
      </iframe>
    </div>
  </div>
</div>

<style is:global>
  [data-desktop-nav] {
    --nav-text: #fff;
    --nav-text-hover: var(--color-grey-300);
    --nav-login: var(--color-grey-300);
    --nav-login-hover: #fff;
  }
  body[data-nav-light] [data-desktop-nav] {
    --nav-text: var(--color-grey-900);
    --nav-text-hover: var(--color-grey-600);
    --nav-login: var(--color-grey-700);
    --nav-login-hover: var(--color-grey-900);
  }
  [data-desktop-nav] [data-nav-item] {
    color: var(--nav-text);
    cursor: pointer;
  }
  [data-desktop-nav] [data-nav-item]:hover {
    color: var(--nav-text-hover);
  }
  [data-dropdown-panel]::before {
    content: "";
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 20px;
  }
  [data-desktop-nav] [data-nav-login] {
    color: var(--nav-login);
  }
  [data-desktop-nav] [data-nav-login]:hover {
    color: var(--nav-login-hover);
  }
  
  [data-desktop-nav] .nav-partner-btn {
    background-color: var(--color-grey-50);
    color: var(--color-grey-900);
    border: 1px solid transparent;
  }
  [data-desktop-nav] .nav-partner-btn:hover {
    background-color: var(--color-grey-200);
  }
  
  body[data-nav-light] [data-desktop-nav] .nav-partner-btn {
    background-color: transparent;
    color: var(--color-grey-700);
    border: 1px solid var(--color-grey-300);
  }
  body[data-nav-light] [data-desktop-nav] .nav-partner-btn:hover {
    border-color: var(--color-grey-600);
    color: var(--color-grey-850);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.querySelector("[data-navbar]") as HTMLElement;
    if (!navbar) return;

    const ac = new AbortController();
    const { signal } = ac;

    const desktopNav = navbar.querySelector(
      "[data-desktop-nav]",
    ) as HTMLElement;
    const mobileMenu = navbar.querySelector(
      "[data-mobile-menu]",
    ) as HTMLElement;
    const hamburger = navbar.querySelector("[data-hamburger]") as HTMLElement;
    const iconOpen = navbar.querySelector(
      '[data-hamburger-icon="open"]',
    ) as HTMLElement;
    const iconClose = navbar.querySelector(
      '[data-hamburger-icon="close"]',
    ) as HTMLElement;

    let lastScrollY = 0;
    let navVisible = true;
    let mobileOpen = false;

    const alwaysLight = document.body.hasAttribute("data-nav-light");

    function getLuminance(bg: string): number | null {
      if (!bg || bg === "transparent" || bg === "rgba(0, 0, 0, 0)") return null;
      const match = bg.match(/\d+/g);
      if (!match || match.length < 3) return null;
      const [r, g, b] = match.map(Number);
      return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
    }

    function isOverLightSection(): boolean {
      if (alwaysLight) return true;
      const navRect = desktopNav.getBoundingClientRect();
      const probeY = navRect.top + navRect.height / 2;
      const probeX = window.innerWidth / 2;
      desktopNav.style.pointerEvents = "none";
      const el = document.elementFromPoint(probeX, probeY);
      desktopNav.style.pointerEvents = "";
      if (!el) return false;

      let current: Element | null = el;
      while (current && current !== document.documentElement) {
        if (current instanceof HTMLElement && current.dataset.navTheme) {
          return current.dataset.navTheme === "light";
        }
        const lum = getLuminance(getComputedStyle(current).backgroundColor);
        if (lum !== null) return lum > 0.5;
        current = current.parentElement;
      }
      return false;
    }

    function updateDesktop() {
      const y = window.scrollY;
      const overLight = isOverLightSection();

      if (y > 20) {
        desktopNav.style.backgroundColor = overLight
          ? "rgba(255,255,255,0.7)"
          : "rgba(33,33,38,0.3)";
        desktopNav.style.backdropFilter = "blur(12px)";
      } else {
        desktopNav.style.backgroundColor = "transparent";
        desktopNav.style.backdropFilter = "none";
      }

      desktopNav.style.setProperty(
        "--nav-text",
        overLight ? "var(--color-grey-900)" : "#fff",
      );
      desktopNav.style.setProperty(
        "--nav-text-hover",
        overLight ? "var(--color-grey-600)" : "var(--color-grey-300)",
      );
      desktopNav.style.setProperty(
        "--nav-login",
        overLight ? "var(--color-grey-700)" : "var(--color-grey-300)",
      );
      desktopNav.style.setProperty(
        "--nav-login-hover",
        overLight ? "var(--color-grey-900)" : "#fff",
      );

      if (y > 600 && y > lastScrollY && navVisible) {
        navVisible = false;
        desktopNav.style.transform = "translateY(-100%)";
      } else if ((y < lastScrollY || y < 600) && !navVisible) {
        navVisible = true;
        desktopNav.style.transform = "translateY(0)";
      }

      lastScrollY = y;
    }

    function setDropdownNavStyle(open: boolean) {
      if (open) {
        const overLight = isOverLightSection();
        desktopNav.style.backdropFilter = "none";
        if (overLight) {
          desktopNav.style.backgroundColor = "#fff";
          desktopNav.style.setProperty("--nav-text", "var(--color-grey-900)");
          desktopNav.style.setProperty(
            "--nav-text-hover",
            "var(--color-grey-600)",
          );
          desktopNav.style.setProperty("--nav-login", "var(--color-grey-700)");
          desktopNav.style.setProperty(
            "--nav-login-hover",
            "var(--color-grey-900)",
          );
        } else {
          desktopNav.style.backgroundColor = "var(--color-dark-800)";
          desktopNav.style.setProperty("--nav-text", "#fff");
          desktopNav.style.setProperty(
            "--nav-text-hover",
            "var(--color-grey-300)",
          );
          desktopNav.style.setProperty("--nav-login", "var(--color-grey-300)");
          desktopNav.style.setProperty("--nav-login-hover", "#fff");
        }
      } else {
        updateDesktop();
      }
    }

    const dropdowns = navbar.querySelectorAll("[data-dropdown]");
    let anyDropdownOpen = false;

    interface DropdownCtx {
      dd: Element;
      trigger: HTMLElement;
      panel: HTMLElement;
      chevron: SVGElement;
      openTimer: ReturnType<typeof setTimeout> | null;
      closeTimer: ReturnType<typeof setTimeout> | null;
      doOpen: () => void;
      doClose: () => void;
    }

    const ddContexts: DropdownCtx[] = [];

    dropdowns.forEach((dd) => {
      const trigger = dd.querySelector(
        "[data-dropdown-trigger]",
      ) as HTMLElement;
      const panel = dd.querySelector("[data-dropdown-panel]") as HTMLElement;
      const chevron = dd.querySelector(
        "[data-dropdown-trigger] svg",
      ) as SVGElement;

      const ctx: DropdownCtx = {
        dd,
        trigger,
        panel,
        chevron,
        openTimer: null,
        closeTimer: null,
        doOpen() {
          if (ctx.openTimer) {
            clearTimeout(ctx.openTimer);
            ctx.openTimer = null;
          }
          if (ctx.closeTimer) {
            clearTimeout(ctx.closeTimer);
            ctx.closeTimer = null;
          }

          ddContexts.forEach((other) => {
            if (other !== ctx) {
              if (other.openTimer) {
                clearTimeout(other.openTimer);
                other.openTimer = null;
              }
              if (other.closeTimer) {
                clearTimeout(other.closeTimer);
                other.closeTimer = null;
              }
              other.panel.classList.add("opacity-0", "invisible");
              other.panel.classList.remove("opacity-100", "visible");
              other.chevron?.classList.remove("rotate-180");
              other.trigger.style.removeProperty("background-color");
              other.trigger.style.removeProperty("color");
              other.trigger.setAttribute("aria-expanded", "false");
            }
          });

          panel.classList.remove("opacity-0", "invisible");
          panel.classList.add("opacity-100", "visible");
          chevron?.classList.add("rotate-180");
          trigger.style.backgroundColor = "var(--color-light-blue-600)";
          trigger.style.color = "#fff";
          trigger.setAttribute("aria-expanded", "true");
          anyDropdownOpen = true;
          setDropdownNavStyle(true);
        },
        doClose() {
          if (ctx.openTimer) {
            clearTimeout(ctx.openTimer);
            ctx.openTimer = null;
          }
          if (ctx.closeTimer) {
            clearTimeout(ctx.closeTimer);
            ctx.closeTimer = null;
          }

          panel.classList.add("opacity-0", "invisible");
          panel.classList.remove("opacity-100", "visible");
          chevron?.classList.remove("rotate-180");
          trigger.style.removeProperty("background-color");
          trigger.style.removeProperty("color");
          trigger.setAttribute("aria-expanded", "false");

          const stillOpen = ddContexts.some((c) =>
            c.panel.classList.contains("visible"),
          );
          if (!stillOpen) {
            anyDropdownOpen = false;
            setDropdownNavStyle(false);
          }
        },
      };

      dd.addEventListener("mouseenter", () => {
        if (ctx.closeTimer) {
          clearTimeout(ctx.closeTimer);
          ctx.closeTimer = null;
        }

        if (anyDropdownOpen) {
          ctx.doOpen();
        } else {
          ctx.openTimer = setTimeout(() => {
            ctx.openTimer = null;
            ctx.doOpen();
          }, 80);
        }
      });

      dd.addEventListener("mouseleave", () => {
        if (ctx.openTimer) {
          clearTimeout(ctx.openTimer);
          ctx.openTimer = null;
        }
        ctx.closeTimer = setTimeout(() => {
          ctx.closeTimer = null;
          ctx.doClose();
        }, 200);
      });

      panel.addEventListener("mouseenter", () => {
        if (ctx.openTimer) {
          clearTimeout(ctx.openTimer);
          ctx.openTimer = null;
        }
        if (ctx.closeTimer) {
          clearTimeout(ctx.closeTimer);
          ctx.closeTimer = null;
        }
      });

      panel.addEventListener("mouseleave", () => {
        if (ctx.openTimer) {
          clearTimeout(ctx.openTimer);
          ctx.openTimer = null;
        }
        ctx.closeTimer = setTimeout(() => {
          ctx.closeTimer = null;
          ctx.doClose();
        }, 200);
      });

      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const isOpen = panel.classList.contains("visible");
          if (isOpen) {
            ctx.doClose();
          } else {
            ctx.doOpen();
          }
        }
      });

      ddContexts.push(ctx);
    });

    function closeAllDropdowns() {
      ddContexts.forEach((ctx) => {
        if (ctx.openTimer) {
          clearTimeout(ctx.openTimer);
          ctx.openTimer = null;
        }
        if (ctx.closeTimer) {
          clearTimeout(ctx.closeTimer);
          ctx.closeTimer = null;
        }
        ctx.panel.classList.add("opacity-0", "invisible");
        ctx.panel.classList.remove("opacity-100", "visible");
        ctx.chevron?.classList.remove("rotate-180");
        ctx.trigger.style.removeProperty("background-color");
        ctx.trigger.style.removeProperty("color");
        ctx.trigger.setAttribute("aria-expanded", "false");
      });
      anyDropdownOpen = false;
      setDropdownNavStyle(false);
    }

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape" && anyDropdownOpen) {
          closeAllDropdowns();
        }
      },
      { signal },
    );

    let scrollTicking = false;
    let prevScrollY = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const delta = Math.abs(window.scrollY - prevScrollY);
        prevScrollY = window.scrollY;
        if (delta > 5 && anyDropdownOpen) closeAllDropdowns();
        if (!scrollTicking) {
          scrollTicking = true;
          requestAnimationFrame(() => {
            updateDesktop();
            scrollTicking = false;
          });
        }
      },
      { signal, passive: true },
    );

    window.addEventListener(
      "resize",
      () => {
        if (!scrollTicking) {
          scrollTicking = true;
          requestAnimationFrame(() => {
            updateDesktop();
            scrollTicking = false;
          });
        }
      },
      { signal, passive: true },
    );

    document.addEventListener(
      "mousemove",
      (e) => {
        if (e.clientY < 100 && !navVisible) {
          navVisible = true;
          desktopNav.style.transform = "translateY(0)";
        }
      },
      { signal },
    );

    hamburger.addEventListener("click", () => {
      mobileOpen = !mobileOpen;
      mobileMenu.classList.toggle("opacity-0", !mobileOpen);
      mobileMenu.classList.toggle("invisible", !mobileOpen);
      mobileMenu.classList.toggle("opacity-100", mobileOpen);
      mobileMenu.classList.toggle("visible", mobileOpen);
      iconOpen.classList.toggle("hidden", mobileOpen);
      iconClose.classList.toggle("hidden", !mobileOpen);
      hamburger.setAttribute("aria-expanded", String(mobileOpen));
      if (mobileOpen) {
        document.body.style.position = "fixed";
        document.body.style.width = "100%";
        document.body.style.top = `-${window.scrollY}px`;
      } else {
        const scrollY = Math.abs(parseInt(document.body.style.top || "0"));
        document.body.style.position = "";
        document.body.style.width = "";
        document.body.style.top = "";
        window.scrollTo(0, scrollY);
      }
    });

    navbar.querySelectorAll("[data-mobile-accordion]").forEach((acc) => {
      const trigger = acc.querySelector(
        "[data-mobile-accordion-trigger]",
      ) as HTMLElement;
      const content = acc.querySelector(
        "[data-mobile-accordion-content]",
      ) as HTMLElement;
      trigger.addEventListener("click", () => {
        const open = !content.classList.contains("hidden");
        content.classList.toggle("hidden");
        trigger.querySelector("svg")?.classList.toggle("rotate-180", !open);
      });
    });

    mobileMenu.querySelectorAll("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", () => {
        mobileOpen = false;
        mobileMenu.classList.add("opacity-0", "invisible");
        mobileMenu.classList.remove("opacity-100", "visible");
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
        const scrollY = Math.abs(parseInt(document.body.style.top || "0"));
        document.body.style.position = "";
        document.body.style.width = "";
        document.body.style.top = "";
        window.scrollTo(0, scrollY);
      });
    });

    // Partner Modal Logic
    const partnerModal = document.getElementById("partner-modal");
    const partnerModalBg = document.getElementById("partner-modal-bg");
    const partnerModalClose = document.getElementById("partner-modal-close");
    const partnerModalContent = document.getElementById("partner-modal-content");
    const partnerTriggers = document.querySelectorAll("[data-partner-trigger]");

    const openPartnerModal = () => {
      if (!partnerModal) return;
      if (mobileOpen) {
        mobileOpen = false;
        mobileMenu.classList.add("opacity-0", "invisible");
        mobileMenu.classList.remove("opacity-100", "visible");
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
        hamburger.setAttribute("aria-expanded", "false");
        document.body.style.position = "";
        document.body.style.width = "";
        document.body.style.top = "";
      }
      partnerModal.classList.remove("hidden");
      partnerModal.classList.add("flex");
      requestAnimationFrame(() => {
        partnerModal.classList.remove("opacity-0", "pointer-events-none");
        if (partnerModalContent) {
          partnerModalContent.classList.remove("scale-95");
          partnerModalContent.classList.add("scale-100");
        }
      });
      document.body.style.overflow = "hidden";
    };

    const closePartnerModal = () => {
      if (!partnerModal) return;
      partnerModal.classList.add("opacity-0", "pointer-events-none");
      if (partnerModalContent) {
        partnerModalContent.classList.remove("scale-100");
        partnerModalContent.classList.add("scale-95");
      }
      setTimeout(() => {
        partnerModal.classList.remove("flex");
        partnerModal.classList.add("hidden");
      }, 300);
      document.body.style.overflow = "";
    };

    partnerTriggers.forEach(btn => btn.addEventListener("click", openPartnerModal));
    if (partnerModalClose) partnerModalClose.addEventListener("click", closePartnerModal);
    if (partnerModalBg) partnerModalBg.addEventListener("click", closePartnerModal);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && partnerModal && !partnerModal.classList.contains("hidden")) {
        closePartnerModal();
      }
    });

    updateDesktop();

    document.addEventListener(
      "astro:before-swap",
      () => {
        ac.abort();
        ddContexts.forEach((ctx) => {
          if (ctx.openTimer) clearTimeout(ctx.openTimer);
          if (ctx.closeTimer) clearTimeout(ctx.closeTimer);
        });
        if (mobileOpen) {
          document.body.style.position = "";
          document.body.style.width = "";
          document.body.style.top = "";
        }
      },
      { once: true },
    );
  });
</script>
