---
import Button from "./Button.astro";

interface Props {
  buttonText?: string;
  buttonLink?: string;
  imageSrc?: string;
}

const {
  buttonText = "Build Your First App",
  buttonLink = "https://pro.openbb.co/register",
  imageSrc = "https://openbb-cms.directus.app/assets/51cd7409-ceed-4630-9fde-b783ea3b0c06.png",
} = Astro.props;
---

<section class="bg-dark-800">
  <div class="flex flex-col lg:flex-row min-h-[400px]">
    <div class="w-full lg:w-1/3 relative">
      <div
        class="w-full h-full min-h-[332px] lg:min-h-[400px] bg-cover bg-center bg-no-repeat"
        style={`background-image: url(${imageSrc})`}
      >
        <div class="absolute inset-0 bg-black/10"></div>
      </div>
    </div>
    <div class="w-full lg:w-2/3 flex items-center justify-center p-6 pb-10 lg:p-12">
      <div class="max-w-3xl text-left w-full">
        <h2 class="text-white text-title-s-regular lg:text-title-l-regular mb-4">
          <span class="block lg:inline">Build Financial Analytics</span>{" "}
          <span class="block lg:inline">That Scale</span>
        </h2>
        <p class="text-grey-100 body-md-regular lg:body-lg-regular mb-6 lg:mb-4">
          Streamlit gets you started. OpenBB gets you to production. With persistent state,
          <br class="hidden md:block" />
          finance-native widgets, modular architecture, and AI copilots designed to save
          <br class="hidden md:block" />
          analysts' time.
        </p>
        <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto">
          <Button variant="accent" size="lg" href={buttonLink} target="_blank" rel="noopener noreferrer" class="w-full lg:w-auto">
            {buttonText}
          </Button>
          <Button variant="outlined" size="lg" href="https://docs.openbb.co/" target="_blank" rel="noopener noreferrer" class="w-full lg:w-auto border-dark-400 text-white hover:border-grey-300 hover:text-white">
            View Documentation
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
