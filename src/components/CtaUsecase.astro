---
import Button from "./Button.astro";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  imageSrc?: string;
}

const {
  title = "Bridge the Gap to AI-Powered Finance",
  description = "Give your team with the tools to move faster, smarter, and more securely.",
  buttonText = "Start now",
  buttonLink = "https://pro.openbb.co/register",
  secondaryButtonText,
  secondaryButtonLink,
  imageSrc = "https://openbb-cms.directus.app/assets/51cd7409-ceed-4630-9fde-b783ea3b0c06.png",
} = Astro.props;
---

<section class="bg-dark-800">
  <div class="flex flex-col lg:flex-row min-h-[400px]">
    <div class="w-full lg:w-1/3 relative">
      <div
        class="w-full h-full min-h-[332px] lg:min-h-[400px] bg-cover bg-center bg-no-repeat"
        style={`background-image: url(${imageSrc})`}
      >
        <div class="absolute inset-0 bg-black/10"></div>
      </div>
    </div>
    <div class="w-full lg:w-2/3 flex items-center justify-center p-6 pb-10 lg:p-12">
      <div class="max-w-3xl text-left w-full">
        <h2 class="text-white text-title-s-regular lg:text-title-l-regular mb-4" set:html={title} />
        <p class="text-grey-100 body-m-regular lg:body-lg-regular mb-6 lg:mb-4" set:html={description} />
        <div class="flex flex-col lg:flex-row gap-4 w-full lg:w-auto">
          <Button variant="accent" size="lg" href={buttonLink} target="_blank" rel="noopener noreferrer" class="w-full lg:w-auto">
            {buttonText}
          </Button>
          {secondaryButtonText && secondaryButtonLink && (
            <Button variant="secondary" size="lg" href={secondaryButtonLink} target="_blank" rel="noopener noreferrer" class="w-full lg:w-auto !border-white !text-white hover:!bg-white/10">
              {secondaryButtonText}
            </Button>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
