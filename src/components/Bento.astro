---
const cards = [
  {
    title: "Consume data from any vendor or source",
    description: "Your vendors, your databases, your internal models, your files. OpenBB connects to all of them, so you stop rebuilding the same integrations every time you need a new view.",
    image: "https://openbb-cms.directus.app/assets/a050a2a1-562c-4a31-9567-92ce26404001.png?format=webp&quality=90&width=1920",
    alt: "Data connectors illustration",
    layout: "bottom" as const,
  },
  {
    title: "Own your workflows and distribute them firm-wide",
    description: "Turn any analysis into an interactive dashboard your whole team can use. Analysts, PMs, and AI agents included.",
    image: "https://openbb-cms.directus.app/assets/090b67a2-dbde-42c6-bc67-2bfded394472.png?format=webp&quality=90&width=1920",
    alt: "OpenBB interface screenshot",
    layout: "right" as const,
  },
  {
    title: "AI that works on your data, inside your environment",
    description: "AI agents get access to the same governed data, context, tools, and interface. They work side-by-side with you, by design.",
    image: "https://openbb-cms.directus.app/assets/03a6987f-8f99-42de-9afd-afbfea93b549.png?format=webp&quality=90&width=1920",
    alt: "AI model integration screenshot",
    layout: "overlay" as const,
  },
  {
    title: "Keep your IP in-house",
    description: "Deploy on-premises or in your private cloud. Your data, your models, your workflows — none of it leaves your environment. No vendor access. No shared infrastructure.",
    image: "https://openbb-cms.directus.app/assets/396cd4e0-5794-4cc1-a173-22ec108948fd.png?format=webp&quality=90&width=1920",
    alt: "Run on-premises illustration",
    layout: "bottom" as const,
  },
];
---

<div class="page-container">
  <div class="mx-auto">
    <h2 class="md:text-title-xl-regular text-title-s-regular text-dark-600 text-left">
      Interactive dashboards that analysts <br />and AI agents can use together
    </h2>
    <p class="body-md-regular md:body-lg-regular text-dark-400 mt-3 md:mt-4 text-left">
      Gated data, fragmented tools, and manual workarounds? That’s the infrastructure problem OpenBB solves.
    </p>

    <!-- Desktop 2x2 grid -->
    <div class="mt-10 md:mt-14 hidden md:flex flex-col gap-10">
      <!-- Row 1 -->
      <div class="grid grid-cols-[480fr_640fr] gap-10 h-[460px]">
        <!-- Connect all your data -->
        <div class="relative overflow-hidden rounded-2xl border border-grey-100 shadow-light-1 transition-transform duration-300">
          <div class="absolute inset-0 bg-grey-50 rounded-2xl"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-2xl p-[50px]">
            <div>
              <p class="body-lg-bold text-dark-600">{cards[0].title}</p>
              <p class="mt-2 body-lg-regular text-dark-400">
                {cards[0].description}
              </p>
            </div>
            <div class="flex flex-1 items-end justify-center -mx-[60px] -mb-0 pt-6">
              <img class="w-[125%] opacity-0 translate-y-6 transition-all duration-1000" data-bento-img src={cards[0].image} alt={cards[0].alt} width="608" height="234" loading="lazy" />
            </div>
          </div>
        </div>

        <!-- Control your interface -->
        <div class="relative overflow-hidden rounded-2xl border border-grey-100 shadow-light-1 transition-transform duration-300">
          <div class="absolute inset-0 bg-grey-50 rounded-2xl"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-2xl p-[50px] pb-0 pr-0">
            <div class="pr-[50px]">
              <p class="body-lg-bold text-dark-600">{cards[1].title}</p>
              <p class="mt-2 body-lg-regular text-dark-400 max-w-lg">
                {cards[1].description}
              </p>
            </div>
            <div class="relative flex-1 mt-4 -ml-[20px]">
              <img class="w-[calc(100%+50px)] h-full rounded-tl-2xl object-cover object-left-top opacity-0 translate-y-6 transition-all duration-1000" data-bento-img src={cards[1].image} alt={cards[1].alt} width="640" height="360" loading="lazy" />
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid grid-cols-[640fr_480fr] gap-10 h-[460px]">
        <!-- Integrate your AI model -->
        <div class="relative overflow-hidden rounded-2xl border border-grey-100 shadow-light-1 transition-transform duration-300">
          <div class="absolute inset-0 bg-grey-50 rounded-2xl"></div>
          <div class="relative h-full overflow-hidden rounded-2xl">
            <img class="absolute top-[-6%] left-[20%] w-[80%] h-auto opacity-0 translate-y-6 transition-all duration-1000" data-bento-img src={cards[2].image} alt={cards[2].alt} width="640" height="460" loading="lazy" />
            <div class="relative z-10 flex flex-col w-[55%] p-[50px]">
              <p class="body-lg-bold text-dark-600">{cards[2].title}</p>
              <p class="mt-4 body-lg-regular text-dark-400">
                {cards[2].description}
              </p>
            </div>
          </div>
        </div>

        <!-- Run on-premises -->
        <div class="relative overflow-hidden rounded-2xl border border-grey-100 shadow-light-1 transition-transform duration-300">
          <div class="absolute inset-0 bg-grey-50 rounded-2xl"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-2xl p-[50px]">
            <div>
              <p class="body-lg-bold text-dark-600">{cards[3].title}</p>
              <p class="mt-2 body-lg-regular text-dark-400">
                {cards[3].description}
              </p>
            </div>
            <div class="flex flex-1 items-center justify-center -mx-[60px] -mt-4">
              <img class="w-[125%] opacity-0 translate-y-6 transition-all duration-1000" data-bento-img src={cards[3].image} alt={cards[3].alt} width="608" height="234" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile stacked layout -->
    <div class="mt-8 md:hidden grid gap-6">
      {cards.map((card) => (
        <div class="relative overflow-hidden rounded-lg border border-grey-100 shadow-light-1">
          <div class="absolute inset-0 bg-grey-50 rounded-lg"></div>
          <div class="relative flex flex-col overflow-hidden rounded-lg">
            <div class="px-4 pt-6">
              <p class="body-md-bold text-dark-600">{card.title}</p>
              <p class="mt-2 body-md-regular text-dark-400">{card.description}</p>
            </div>
            <div class:list={[
              "overflow-hidden",
              card.layout === "right" ? "mt-4 h-[220px]" : card.layout === "overlay" ? "mt-4 pb-0 h-[240px]" : "flex items-end justify-center -mx-4 -mb-4 mt-6",
            ]}>
              <img
                class:list={[
                  "w-full",
                  card.layout === "right" ? "h-full rounded-tl-md object-cover object-left-top" : card.layout === "overlay" ? "rounded-2xl object-cover object-top" : "",
                ]}
                src={card.image}
                alt={card.alt}
                width="375"
                height="240"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const bentoImgs = document.querySelectorAll("[data-bento-img]");
    if (bentoImgs.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
            io.unobserve(el);
          }
        });
      }, { threshold: 0.2 });
      bentoImgs.forEach((img) => io.observe(img));
    }
  });
</script>
