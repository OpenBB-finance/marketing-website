# Copy this file to `.env` and fill in what you need. Every variable is OPTIONAL:
# the site builds and runs with none of them set. Never commit `.env`.
#
# Variables prefixed with PUBLIC_ are inlined into the browser bundle by Astro.
# Everything else is only available at build time on the server.

# --- Directus CMS ---
# Build-time only. Published blog posts and the wind-down letter are readable
# anonymously; this token additionally unlocks the homepage banner (Global
# collection) and any content that is not public.
DIRECTUS_TOKEN=

# Browser-exposed read token used by /blog/preview?slug=... to render drafts.
PUBLIC_DIRECTUS_PREVIEW_TOKEN=

# --- PostHog analytics ---
# Both must be set for analytics to load; otherwise no tracking script runs.
PUBLIC_POSTHOG_API_KEY=
PUBLIC_POSTHOG_API_HOST=

# --- Stripe (OpenBB Lite checkout) ---
# Overrides the Stripe Payment Link used on /lite pages. Falls back to the
# value hard-coded in src/data/lite.ts when unset.
PUBLIC_STRIPE_LITE_CHECKOUT_URL=
